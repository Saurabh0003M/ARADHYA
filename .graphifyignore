__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
venv/
env/
ENV/
.python313/
.vscode/
.idea/
.pytest_cache/
htmlcov/
pytest-cache-files-*/
pytest_tmp*/
pytest_basetemp*/
.pytest_*/
.tmp/
python_temp*/
Hosts/
freellmapi/
scratch/
*.plan.md

